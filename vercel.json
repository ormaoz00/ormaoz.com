{
  "rewrites": [
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "lp.ormaoz.com" }
      ],
      "destination": "/apps/funnel/index.html"
    },
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "lp.ormaoz.com" }
      ],
      "destination": "/apps/funnel/$1"
    },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "diary.ormaoz.com" }
      ],
      "destination": "/apps/diary/index.html"
    },
    {
      "source": "/(.*)",
      "has": [
        { "type": "host", "value": "diary.ormaoz.com" }
      ],
      "destination": "/apps/diary/$1"
    },
    {
      "source": "/",
      "destination": "/README.md"
    }
  ]
}
